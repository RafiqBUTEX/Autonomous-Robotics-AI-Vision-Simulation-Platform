<?xml version="1.0"?>
<robot name="car_robot">

  <link name="base_link">
    <visual>
      <geometry><box size="0.75 0.45 0.3"/></geometry>

<material name="body_red">
  <color rgba="0.75 0.1 0.1 1"/>
</material>
<material name="wheel_black">
  <color rgba="0.05 0.05 0.05 1"/>
</material>
<material name="camera_white">
  <color rgba="0.95 0.95 0.95 1"/>
</material>     
 
    </visual>
    <collision>
      <geometry><box size="0.5 0.3 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Rear wheels: driven -->
  <link name="wheel_rear_left">
    <visual><geometry><cylinder radius="0.12" length="0.075"/></geometry></visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="base_to_wheel_rear_left" type="continuous">
    <parent link="base_link"/><child link="wheel_rear_left"/>
    <origin xyz="-0.225 0.27 -0.075" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_rear_right">
    <visual><geometry><cylinder radius="0.12" length="0.075"/></geometry></visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="base_to_wheel_rear_right" type="continuous">
    <parent link="base_link"/><child link="wheel_rear_right"/>
    <origin xyz="-0.225 -0.27 -0.075" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Front wheels: passive (free-spinning) -->
  <link name="wheel_front_left">
    <visual><geometry><cylinder radius="0.12" length="0.075"/></geometry></visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="base_to_wheel_front_left" type="continuous">
    <parent link="base_link"/><child link="wheel_front_left"/>
    <origin xyz="0.225 0.27 -0.075" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_front_right">
    <visual><geometry><cylinder radius="0.12" length="0.075"/></geometry></visual>
    <collision><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="base_to_wheel_front_right" type="continuous">
    <parent link="base_link"/><child link="wheel_front_right"/>
    <origin xyz="0.225 -0.27 -0.075" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!--Front  Camera -->
  <link name="camera_link">
    <visual><geometry><box size="0.03 0.075 0.075"/></geometry></visual>
  </link>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.375 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- Diff drive plugin (uses rear wheels) -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>base_to_wheel_rear_left</left_joint>
      <right_joint>base_to_wheel_rear_right</right_joint>
      <wheel_separation>0.54</wheel_separation>
      <wheel_diameter>0.24</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

<!-- Rear Camera -->
  <link name="camera_link_rear">
    <visual>
      <geometry><box size="0.03 0.075 0.075"/></geometry>
      <material name="camera_white"/>
    </visual>
  </link>
  <joint name="base_to_camera_rear" type="fixed">
    <parent link="base_link"/><child link="camera_link_rear"/>
    <origin xyz="-0.375 0 0.075" rpy="0 0 3.14159"/>
  </joint>

  <gazebo reference="camera_link_rear">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="camera_link_rear">
    <sensor type="camera" name="car_camera_rear">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_controller_rear" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
        <camera_name>car_camera_rear</camera_name>
        <frame_name>camera_link_rear</frame_name>
      </plugin>
    </sensor>
  </gazebo>

<gazebo reference="camera_link">
    <sensor type="depth" name="car_depth_camera">
      <update_rate>20.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20</far></clip>
      </camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
        </ros>
        <camera_name>car_depth</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

<gazebo reference="base_link">
  <material>Gazebo/Red</material>
</gazebo>
<gazebo reference="wheel_rear_left"><material>Gazebo/Black</material></gazebo>
<gazebo reference="wheel_rear_right"><material>Gazebo/Black</material></gazebo>
<gazebo reference="wheel_front_left"><material>Gazebo/Black</material></gazebo>
<gazebo reference="wheel_front_right"><material>Gazebo/Black</material></gazebo>
<gazebo reference="camera_link"><material>Gazebo/White</material></gazebo>

  <!-- Camera plugin -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="car_camera">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
        <camera_name>car_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

     <!-- LiDAR -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor type="ray" name="car_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>	

</robot>
